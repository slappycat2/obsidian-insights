# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# ---------------------------------------------------------------------------
# v_chk runtime output and local configuration
#
# CONFIG.yaml is generated by the setup screen and contains machine-specific
# paths to your vaults -- it must never be committed. Everything under data/
# and logs/ is regenerated on every run.
# ---------------------------------------------------------------------------
CONFIG.yaml
vault_check/data/
vault_check/logs/
data/
logs/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Claude Code / MCP (machine-specific: the PyCharm MCP URL has a local port)
# ---------------------------------------------------------------------------
.claude/settings.local.json
.mcp.json

# ---------------------------------------------------------------------------
# OS / application cruft
# ---------------------------------------------------------------------------
desktop.ini
Thumbs.db
.DS_Store
~$*.xlsx

# ---------------------------------------------------------------------------
# Node.js build artifacts.
#
# xcluded/obsidian-config-cli/ is an old TypeScript helper for locating the
# Obsidian config directory -- a job v_chk_obs_app.py now does natively. Its
# source is kept, but node_modules (25 MB) and the pkg-bundled 36 MB .exe are
# reinstallable artifacts and would bloat git history permanently.
# ---------------------------------------------------------------------------
node_modules/
*.exe
xcluded/obsidian-config-cli/dist/
