# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# ---------------------------------------------------------------------------
# v_chk runtime output and local configuration
#
# CONFIG.yaml is generated by the setup screen and contains machine-specific
# paths to your vaults -- it must never be committed. Everything under data/
# and logs/ is regenerated on every run. Their location is resolved by
# v_chk_paths._resolve_data_root() and can be redirected with V_CHK_DATA_DIR.
# ---------------------------------------------------------------------------
# NOTE the leading slashes: they anchor each pattern to the repository root.
# Without them, "vault_check/" also matches src/vault_check/ -- which silently
# excluded the entire package from git and produced a wheel containing nothing
# but metadata. Keep these anchored.
/CONFIG.yaml
/data/
/logs/

# Pre-Phase-2 location of the above. A leftover holding only generated output;
# safe to delete. Ignored so it cannot be committed by accident meanwhile.
/vault_check/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Claude Code / MCP (machine-specific: the PyCharm MCP URL has a local port)
# ---------------------------------------------------------------------------
.claude/settings.local.json
.mcp.json

# ---------------------------------------------------------------------------
# OS / application cruft
# ---------------------------------------------------------------------------
desktop.ini
Thumbs.db
.DS_Store
~$*.xlsx

# ---------------------------------------------------------------------------
# Node.js build artifacts.
# ---------------------------------------------------------------------------
node_modules/
*.exe

# Old scratch code, untracked since Phase 4 and recoverable from commit
# d24449d. The directory may still exist on disk; it is safe to delete.
xcluded/

# ---------------------------------------------------------------------------
# Working notes: deliberately local
#
# Repo administration, open decisions and session working agreements. Tracked
# from 2026-07-29 until 2026-08-18, so earlier revisions remain in history --
# untracking it keeps future edits out of anything that could be published.
# The file still lives on disk and is still the right place for that material.
# ---------------------------------------------------------------------------
/docs/WORKING-NOTES.md

# Screenshots and widget dumps from tools/ui_shot.py. Regenerated on demand and
# specific to one machine's display scaling, so they are not worth tracking.
/tools/_shots/
